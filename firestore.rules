rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HÀM HỖ TRỢ (HELPER FUNCTIONS) ---

    // Lấy thông tin user hiện tại từ database
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Kiểm tra có phải Admin không
    function isAdmin() {
      return getUserData().role == 'admin' || request.auth.token.email == 'thanhphucn06@gmail.com';
    }

    // Kiểm tra có phải Giáo viên không
    function isTeacher() {
      return getUserData().role == 'teacher';
    }

    // Kiểm tra tài khoản đã được kích hoạt (Student/Teacher)
    function isWhitelisted() {
      // Safe check if field exists, though usually it should
      return getUserData().isWhitelisted == true;
    }

    // --- COLLECTION: USERS ---
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (isAdmin() || resource.data.email == request.auth.token.email);
    }

    // --- COLLECTION: ASSIGNMENTS (Bài tập) ---
    match /assignments/{assignmentId} {
      allow read: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        resource.data.createdByTeacherId == request.auth.uid ||
        isWhitelisted() ||
        isAdmin() ||
        isTeacher()
      );

      allow create: if request.auth != null && (
        isAdmin() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          (resource.data.teacherId == request.auth.uid || resource.data.createdByTeacherId == request.auth.uid) &&
          (request.resource.data.teacherId == request.auth.uid || request.resource.data.teacherId == resource.data.teacherId)
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.createdByTeacherId == request.auth.uid
      );
    }

    // --- COLLECTION: COURSES (Khóa học) ---
    match /courses/{courseId} {
      allow read: if request.auth != null || true; // Public can read courses
      allow write: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: ORDERS (Đơn hàng) ---
    match /orders/{orderId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null; // Any logged in user can create an order
      allow update, delete: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: SUBJECTS (Môn học) ---
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isTeacher() || isAdmin());
      allow update, delete: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: NOTIFICATIONS (Thông báo) ---
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && isAdmin();
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
    }

    // --- COLLECTION: ANNOUNCEMENTS (Bảng tin) ---
    match /announcements/{announcementId} {
      allow read, write: if request.auth != null && isAdmin();
      allow read: if request.auth != null;
    }

    // --- COLLECTION: APP SETTINGS ---
    match /app_settings/{settingId} {
      allow read: if true; // Public read cho landing page
      allow write: if request.auth != null && isAdmin(); // Chỉ Admin có quyền ghi/sửa cấu hình
    }

    // --- COLLECTION: ANALYTICS (Thống kê) ---
    // Fixed: Explicitly allow list/query by not restricting to a single docId match for read
    // The previous rule `match /analytics_daily/{dateId}` was fine for get/list, but `allow read` is broad.
    // However, for complex queries like `where`, rules must validate the query constraints.
    // Since we are building an internal tool, we keep it simple: allow all authenticated reads.
    match /analytics_daily/{dateId} {
      allow read, write: if true; // Public write/read for anonymous visitors

      // Allow operations on the subcollection
      match /visitors/{visitorId} {
        allow read, write: if true;
      }
    }
    match /analytics_aggregates/{docId} {
      allow read, write: if true;
    }

    // --- COLLECTION: FINANCIAL TRANSACTIONS (Tài chính) ---
    match /financial_transactions/{transactionId} {
      allow read, write: if request.auth != null && isAdmin();
    }
  }
}
