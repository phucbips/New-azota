rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HÀM HỖ TRỢ (HELPER FUNCTIONS) ---

    // Lấy thông tin user hiện tại từ database
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Kiểm tra có phải Admin không
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'thanhphucn06@gmail.com' ||
        request.auth.token.email == 'thanhphucn4u@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    // Kiểm tra có phải Giáo viên không
    function isTeacher() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'teacher';
    }

    // --- COLLECTION: USERS ---
    // Học viên không được tự nâng quyền (role) hoặc tự mở khóa học (enrolledCourses) trên hồ sơ của mình
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'student' &&
          (!('enrolledCourses' in request.resource.data) || request.resource.data.enrolledCourses.size() == 0)
        )
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'enrolledCourses', 'email', 'uid'])
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        (resource.data.email == request.auth.token.email && userId != request.auth.uid)
      );
    }

    // --- COLLECTION: ASSIGNMENTS (Bài tập) ---
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && (
        isAdmin() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          (resource.data.teacherId == request.auth.uid || resource.data.createdByTeacherId == request.auth.uid) &&
          (request.resource.data.teacherId == request.auth.uid || request.resource.data.teacherId == resource.data.teacherId)
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.createdByTeacherId == request.auth.uid
      );
    }

    // --- COLLECTION: COURSES (Khóa học) ---
    match /courses/{courseId} {
      allow read: if true; // Public can read courses
      allow write: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: ORDERS (Đơn hàng) ---
    // Học viên chỉ được tạo đơn 'pending' (có phí) hoặc đơn 'paid' 0đ nếu khóa học thực sự miễn phí (price == 0).
    // Học viên KHÔNG được tự sửa status thành 'paid'/'pay_later' hay sửa số tiền (amount); việc duyệt đơn do Server (PayOS) hoặc Admin thực hiện.
    match /orders/{orderId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid &&
          (
            (request.resource.data.status == 'pending' && request.resource.data.amount > 0) ||
            (
              request.resource.data.status == 'paid' &&
              request.resource.data.amount == 0 &&
              request.resource.data.items.size() == 1 &&
              get(/databases/$(database)/documents/courses/$(request.resource.data.items[0].courseId)).data.price == 0
            )
          )
        )
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          resource.data.status in ['pending', 'pay_later'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['checkoutUrl', 'orderCode', 'previousOrderCodes', 'displayCode', 'updatedAt'])
        )
      );

      allow delete: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: SUBJECTS (Môn học) ---
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isTeacher() || isAdmin());
      allow update, delete: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: NOTIFICATIONS (Thông báo) ---
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && isAdmin();
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
    }

    // --- COLLECTION: ANNOUNCEMENTS (Bảng tin) ---
    match /announcements/{announcementId} {
      allow read, write: if request.auth != null && isAdmin();
      allow read: if request.auth != null;
    }

    // --- COLLECTION: VOUCHERS (Mã giảm giá) ---
    match /vouchers/{voucherId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: APP SETTINGS ---
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: ANALYTICS (Thống kê) ---
    match /analytics_daily/{dateId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && isAdmin();

      match /visitors/{visitorId} {
        allow read, create, update: if true;
        allow delete: if request.auth != null && isAdmin();
      }
    }

    match /analytics_aggregates/{docId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: FINANCIAL TRANSACTIONS (Tài chính) ---
    match /financial_transactions/{transactionId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: AUDIT LOGS ---
    match /audit_logs/{logId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null && isAdmin();
      allow update, delete: if false;
    }
  }
}
