rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HÀM HỖ TRỢ (HELPER FUNCTIONS) ---

    // Lấy thông tin user hiện tại từ database
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Kiểm tra có phải Admin không
    function isAdmin() {
      // Check role AND specific email fallback for hardcoded admin
      return getCurrentUser().role == 'admin' || request.auth.token.email == 'thanhphucn06@gmail.com';
    }

    // Kiểm tra có phải Giáo viên không
    function isTeacher() {
      return getCurrentUser().role == 'teacher';
    }

    // Kiểm tra tài khoản đã được kích hoạt chưa (Student cần cái này)
    function isWhitelisted() {
      return getCurrentUser().isWhitelisted == true;
    }

    // --- COLLECTION: USERS ---
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Allow update self or admin
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Allow delete self (invitation cleanup) or admin
      allow delete: if request.auth != null && (isAdmin() || resource.data.email == request.auth.token.email);
    }

    // --- COLLECTION: ASSIGNMENTS (Bài tập) ---
    match /assignments/{assignmentId} {
      // Allow read if authenticated and whitelisted (active student/teacher)
      allow read: if request.auth != null && isWhitelisted();

      // Allow create if user is teacher or admin
      // Note: Data validation could be added here (e.g. enforcing teacherId == auth.uid)
      allow create: if request.auth != null && (isTeacher() || isAdmin());

      // Allow update/delete if:
      // 1. Admin
      // 2. Teacher AND is the owner (teacherId matches UID)
      allow update, delete: if request.auth != null && (
        isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        // Fallback compatibility
        (isTeacher() && resource.data.createdByTeacherId == request.auth.uid)
      );
    }
  }
}
