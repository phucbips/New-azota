rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the current user's document
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return getCurrentUser().role == 'admin';
    }

    function isTeacher() {
      return getCurrentUser().role == 'teacher';
    }

    function isWhitelisted() {
      return getCurrentUser().isWhitelisted == true;
    }

    // Collection: users
    match /users/{userId} {
      // READ:
      // 1. Users must be able to read their own doc (get).
      // 2. Admins must be able to read all docs (list/get).
      // 3. CRITICAL: New users (auth but not fully set up) need to query users by email to find their invitation.
      //    So we must allow 'list' for authenticated users to support `findUserByEmail`.
      //    If we restrict this, the invitation flow breaks for non-admins.
      allow read: if request.auth != null;

      // CREATE: User creates their own doc on signup.
      allow create: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );

      // UPDATE: User updates own doc (session, etc) OR Admin updates any doc.
      allow update: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );

      // DELETE: Only Admin can delete users.
      allow delete: if request.auth != null && isAdmin();
    }

    // Collection: assignments (Codebase uses 'assignments', NOT 'lessons')
    match /assignments/{assignmentId} {

      // READ/LIST: Any whitelisted user (Student, Teacher, Admin) can see assignments.
      allow read: if request.auth != null && isWhitelisted();

      // WRITE: Only Teachers and Admins can create/update/delete assignments.
      allow write: if request.auth != null && (isTeacher() || isAdmin());
    }
  }
}
