rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HÀM HỖ TRỢ (HELPER FUNCTIONS) ---

    // Lấy thông tin user hiện tại từ database
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Kiểm tra có phải Admin không
    function isAdmin() {
      return getCurrentUser().role == 'admin';
    }

    // Kiểm tra có phải Giáo viên không
    function isTeacher() {
      return getCurrentUser().role == 'teacher';
    }

    // Kiểm tra tài khoản đã được kích hoạt chưa (Student cần cái này)
    function isWhitelisted() {
      return getCurrentUser().isWhitelisted == true;
    }

    // --- COLLECTION: USERS ---
    match /users/{userId} {
      // READ (Đọc):
      // Cho phép tất cả user đã đăng nhập được đọc.
      // LÝ DO: Khi user mới đăng nhập lần đầu, họ cần query (tìm kiếm) trong collection 'users'
      // bằng email của mình để xem có "lời mời" (invitation) nào từ Admin tạo trước đó không.
      // Nếu chặn quyền này, tính năng tự động nhận role/grade sẽ bị lỗi với user thường.
      allow read: if request.auth != null;

      // CREATE (Tạo): User tự tạo doc của mình khi đăng nhập lần đầu HOẶC Admin tạo (lời mời).
      allow create: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );

      // UPDATE (Cập nhật): User cập nhật thông tin mình (ví dụ: sessionId) HOẶC Admin cập nhật.
      allow update: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );

      // DELETE (Xóa): Chỉ Admin mới được xóa user.
      allow delete: if request.auth != null && isAdmin();
    }

    // --- COLLECTION: ASSIGNMENTS (Bài tập) ---
    // Lưu ý: Trong code đang dùng collection tên là "assignments", KHÔNG PHẢI "lessons".
    match /assignments/{assignmentId} {

      // READ (Đọc):
      // Admin, Teacher, Student đều xem được, MIỄN LÀ đã được kích hoạt (whitelisted).
      // Điều này ngăn user chưa được duyệt xem nội dung.
      allow read: if request.auth != null && isWhitelisted();

      // WRITE (Ghi - Tạo/Sửa/Xóa):
      // Chỉ Giáo viên và Admin mới có quyền quản lý bài tập.
      // Học sinh KHÔNG được phép tạo bài tập.
      allow write: if request.auth != null && (isTeacher() || isAdmin());
    }
  }
}
