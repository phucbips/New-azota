rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HÀM HỖ TRỢ (HELPER FUNCTIONS) ---

    // Lấy thông tin user hiện tại từ database
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Kiểm tra có phải Admin không
    function isAdmin() {
      return getCurrentUser().role == 'admin';
    }

    // Kiểm tra có phải Giáo viên không
    function isTeacher() {
      return getCurrentUser().role == 'teacher';
    }

    // Kiểm tra tài khoản đã được kích hoạt chưa (Student cần cái này)
    function isWhitelisted() {
      return getCurrentUser().isWhitelisted == true;
    }

    // --- COLLECTION: USERS ---
    match /users/{userId} {
      // READ (Đọc):
      // Cho phép tất cả user đã đăng nhập được đọc.
      allow read: if request.auth != null;

      // CREATE (Tạo): User tự tạo doc của mình khi đăng nhập lần đầu HOẶC Admin tạo (lời mời).
      allow create: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );

      // UPDATE (Cập nhật): User cập nhật thông tin mình HOẶC Admin cập nhật.
      allow update: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );

      // DELETE (Xóa):
      // 1. Admin được xóa bất kỳ ai.
      // 2. User được phép xóa document nếu document đó có field 'email' trùng với email đăng nhập của họ.
      //    (Dùng để tự xóa "lời mời/invitation" cũ sau khi đã tạo tài khoản chính thức).
      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.email == request.auth.token.email
      );
    }

    // --- COLLECTION: ASSIGNMENTS (Bài tập) ---
    match /assignments/{assignmentId} {

      // READ (Đọc):
      allow read: if request.auth != null && isWhitelisted();

      // WRITE (Ghi):
      allow write: if request.auth != null && (isTeacher() || isAdmin());
    }
  }
}
