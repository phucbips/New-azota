rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HÀM HỖ TRỢ (HELPER FUNCTIONS) ---

    // Lấy thông tin user hiện tại từ database
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Kiểm tra có phải Admin không
    function isAdmin() {
      return getCurrentUser().role == 'admin';
    }

    // Kiểm tra có phải Giáo viên không
    function isTeacher() {
      return getCurrentUser().role == 'teacher';
    }

    // Kiểm tra tài khoản đã được kích hoạt chưa (Student cần cái này)
    function isWhitelisted() {
      return getCurrentUser().isWhitelisted == true;
    }

    // --- COLLECTION: USERS ---
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (isAdmin() || resource.data.email == request.auth.token.email);
    }

    // --- COLLECTION: ASSIGNMENTS (Bài tập) ---
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;

      // Allow create if user is teacher or admin
      allow create: if request.auth != null && (isTeacher() || isAdmin());

      // Allow update/delete if admin OR (teacher AND owner)
      // Note: "owner" check requires reading the resource being updated/deleted.
      allow update, delete: if request.auth != null && (
        isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        // Fallback for legacy documents using createdByTeacherId
        (isTeacher() && resource.data.createdByTeacherId == request.auth.uid)
      );
    }
  }
}
